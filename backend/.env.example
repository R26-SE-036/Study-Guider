# ============================================================================
# REFERENCE, NOT A REPLACEMENT.
#
# This file lists every setting this service understands - the ones it always
# had, plus the ones added for Code Guru integration.
#
# If you ALREADY have a .env, do not copy this over it: your .env holds real
# credentials that exist nowhere else. Compare the two and add only the keys
# you are missing. Copy the whole file only if you have no .env at all.
# ============================================================================

# ── Code Coach: the platform's identity provider ──
# Every request to this service carries a Code Coach access token, and Study
# Guider verifies it here. Nothing works without this set correctly.
CODE_COACH_URL=http://127.0.0.1:8000
CODE_COACH_CLIENT_NAME=codeguru-study-guider
CODE_COACH_TIMEOUT_SECONDS=10

# Seconds a verified token is trusted before re-checking with Code Coach.
AUTH_CACHE_TTL_SECONDS=60

# Browser origins allowed to call this API: the Vite dev server and the portal.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4200,http://127.0.0.1:4200

# ── Neo4j (student progress graph) ──
NEO4J_URI=neo4j+s://<your-instance>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ── LLM providers ──
OPENROUTER_API_KEY=
GEMINI_API_KEY=
