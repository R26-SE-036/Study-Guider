# ============================================================================
# REFERENCE, NOT A REPLACEMENT.
#
# Every setting this service reads is below - there are six, and the service
# reads nothing else. If you ALREADY have a .env, do not copy this over it:
# yours holds real credentials that exist nowhere else. Compare the two and
# delete anything of yours that is not listed here, because it is no longer
# read by anything.
# ============================================================================

# ── Code Coach: the platform's identity provider ──
# Every request to this service carries a Code Coach access token, and Study
# Guider verifies it there. Nothing works without this set correctly.
CODE_COACH_URL=http://127.0.0.1:8000
CODE_COACH_TIMEOUT_SECONDS=10

# Seconds a verified token is trusted before re-checking with Code Coach.
AUTH_CACHE_TTL_SECONDS=60

# ── Neo4j: the student progress graph ──
# Holds attempts, cached lessons and the concept prerequisite edges.
NEO4J_URI=neo4j+s://<your-instance>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ── Gemini: lessons, quizzes, and the syllabus embeddings ──
# One provider, one key. Lessons and quizzes fail with a 503 rather than
# serving invented content when this is missing or out of quota.
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
# MODEL_NAME=gemini-2.5-flash

# ── Removed, and why ─────────────────────────────────────────────────────────
# CORS_ORIGINS            No browser talks to this service. The web app calls
#                         it server-side through its BFF, so requests arrive
#                         with no Origin header and no preflight.
# OPENROUTER_API_KEY      Generation moved to Gemini; nothing read this.
# CODE_COACH_CLIENT_NAME  Declared but never referenced by any code path.
