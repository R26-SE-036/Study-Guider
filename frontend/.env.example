# Study Guider's own backend.
VITE_API_BASE_URL=http://127.0.0.1:8010

# Code Coach — the platform's identity provider. Token refreshes go here.
VITE_CODE_COACH_URL=http://127.0.0.1:8000

# The shared Code Guru portal. A student with no session is sent here to sign
# in, and comes back with the session attached.
VITE_PORTAL_URL=http://localhost:4200

# Enables the localhost-only /dev-login form so you can work on Study Guider
# without running the portal. Ignored unless the page is served from localhost.
# Leave this unset in any deployed build.
VITE_ENABLE_DEV_LOGIN=true
